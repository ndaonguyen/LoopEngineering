{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "GitHub": {
    "Owner": "ndaonguyen",
    "Repository": "LoopEngineering",
    "PollInterval": "01:00:00",
    "ProductHeader": "loop-engine",
    "Token": ""
  },
  "Anthropic": {
    "Model": "claude-sonnet-5",
    "MaxOutputTokens": 16000,
    "OutputDirectory": "output/investigations",
    "ApiKey": ""
  },
  "Pipeline": {
    "GenerateFix": false,
    "VerifyFix": false
  },
  "Verification": {
    "MaxAttempts": 5,
    "TestProject": "tests/Loop.Engine.Tests/Loop.Engine.Tests.csproj",
    "Timeout": "00:05:00"
  },
  "Repository": {
    "RootPath": "../..",
    "IncludeGlobs": [ "source/**/*.cs", "tests/**/*.cs" ],
    "MaxFiles": 15,
    "MaxLinesPerFile": 400
  }
}
