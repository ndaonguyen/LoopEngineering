{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "GitHub": {
    "Owner": "ndaonguyen",
    "Repository": "LoopEngineering",
    "PollInterval": "01:00:00",
    "ProductHeader": "loop-engine",
    "Token": ""
  },
  "Ai": {
    "Model": "gpt-4o-mini",
    "ReasoningModel": "gpt-4o-mini",
    "MaxOutputTokens": 16000,
    "OutputDirectory": "output/investigations",
    "InputCostPerMillion": 0,
    "OutputCostPerMillion": 0,
    "AnthropicApiKey": "",
    "OpenAiApiKey": ""
  },
  "Pipeline": {
    "RequiredLabel": "bug",
    "GenerateFix": false,
    "VerifyFix": false,
    "PublishPr": false
  },
  "Publishing": {
    "BranchPrefix": "fix/",
    "Remote": "origin",
    "BaseBranch": "main",
    "NeedsHumanLabel": "needs-human"
  },
  "Verification": {
    "MaxAttempts": 5,
    "TestProject": "tests/Loop.Engine.Tests/Loop.Engine.Tests.csproj",
    "Timeout": "00:05:00"
  },
  "Repository": {
    "RootPath": "../..",
    "IncludeGlobs": [ "source/**/*.cs", "tests/**/*.cs" ],
    "MaxFiles": 15,
    "MaxLinesPerFile": 400
  }
}
